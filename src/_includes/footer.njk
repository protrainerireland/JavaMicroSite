<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <section class="site-footer__about" aria-labelledby="footer-training">
      <h2 id="footer-training">{{ site.searchKeywords[0] }} training</h2>
      {% for text in seo.footertext %}
        <p>{{ text }}</p>
      {% endfor %}
      <p><a href="/courses/">View all courses</a></p>
    </section>

    <section aria-labelledby="footer-offices">
      <h2 id="footer-offices">Our offices</h2>
      <address>
        <p><strong>Cork</strong><br>{{ site.address | formatAddress }}</p>
        <p><strong>Dublin</strong><br>{{ site.addressDublin | formatAddress }}</p>
        <p><strong>Limerick</strong><br>{{ site.addressLimerick | formatAddress }}</p>
      </address>
    </section>

    <section id="contact" aria-labelledby="footer-contact">
      <h2 id="footer-contact">Contact us</h2>
      <ul class="contact-list">
        <li>Cork <a href="tel:{{ site.phone | replace(' ', '') }}">{{ site.phone }}</a></li>
        <li>Dublin <a href="tel:{{ site.phoneDublin | replace(' ', '') }}">{{ site.phoneDublin }}</a></li>
        <li>Limerick <a href="tel:{{ site.phoneLimerick | replace(' ', '') }}">{{ site.phoneLimerick }}</a></li>
        <li>Email <a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
      </ul>
    </section>
  </div>

  <div class="wrap site-footer__legal">
    <p>&copy; {% year %} {{ site.organisation.name }}. All rights reserved.</p>
    <p><a href="/privacy/">Privacy policy</a> <span aria-hidden="true">/</span> Designed by <a href="{{ site.designer.link }}">{{ site.designer.name }}</a></p>
  </div>
</footer>
