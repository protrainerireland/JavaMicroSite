---
layout: base_layout
---
{% include "StructuredData/carousel.njk" %}

{% include "StructuredData/instances.njk" %}

<header class="page-head">
  <div class="wrap">
    <h1>{{ site.searchKeywords | join }} course schedule</h1>
    <p class="page-head__lead">Upcoming public dates in Dublin, Cork, Limerick and live online. Choose a date and book your place, or contact us to run a course for your team.</p>
  </div>
</header>

<div class="wrap schedule">
{% for courseItem in coursesapifull.courses %}
  {% if courseItem.schedule.length > 0 %}
  <section class="schedule__course" aria-labelledby="sched-{{ courseItem.id }}">
    <div class="schedule__head">
      <h2 id="sched-{{ courseItem.id }}">{{ courseItem.name }}</h2>
      <a href="/courses/{{ courseItem.name | slug | removeInvalidChars }}/">Course details<span class="visually-hidden"> for {{ courseItem.name }}</span></a>
    </div>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr><th scope="col">Date</th><th scope="col">Location</th><th scope="col"><span class="visually-hidden">Booking</span></th></tr>
        </thead>
        <tbody>
        {% for instance in courseItem.schedule %}
          {{ instance | formatScheduleInstance("table", courseItem) | safe }}
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endif %}
{% endfor %}
</div>
