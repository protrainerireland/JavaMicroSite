    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/">
          <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <rect width="32" height="32" rx="8"/>
            <text x="16" y="22.5" text-anchor="middle">{{ site.searchKeywords[0] | first }}</text>
          </svg>
          <span class="brand__text">
            <span class="brand__name">{{ site.searchKeywords[0] }} Training</span>
            <span class="brand__org">{{ site.organisation.name }}</span>
          </span>
        </a>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          Menu
        </button>

        <nav class="site-nav" id="site-menu" aria-label="Main">
          <ul>
            {% for item in home.sections %}
              {% if item.link != "no" %}
                <li><a href="{{ item.link }}"{% if item.link == page.url %} aria-current="page"{% endif %}>{{ item.text }}</a></li>
              {% endif %}
            {% endfor %}
            {% for item in collections.main %}
                <li><a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.data.title }}</a></li>
            {% endfor %}
          </ul>
        </nav>
      </div>
    </header>
