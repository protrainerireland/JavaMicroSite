  <script type="application/ld+json">
{
    "@context" : "https://schema.org",
    "@type" : "EducationalOrganization",
    "name" : "{{ site.organisation.name }}",
    "url": "https://www.professional.ie/",
    "sameAs": "{{ site.social.linkedin }}",
    "logo": "https://www.professional.ie/img/favicon.bmp",
    "image": "{{ site.logo }}",
    "description": "Professional Training, with offices in Dublin, Cork and Limerick, Ireland, is a provider of top quality business training courses, IT training courses and programming training courses.",
    "telephone" : [ "{{ site.phoneDublin }}", "{{ site.phone }}", "{{ site.phoneLimerick }}" ],
    "email" : "{{ site.email }}",
    "address" : {% officeAddresses %},
    "department": {
        "@type": "EducationalOrganization",
        "name": "{{ site.organisation.department }}",
        "url": "https://{{ site.url }}/"
    }
}
</script>
