  <!-- EducationalEvents: every date for this course, or for all courses on the schedule page -->
{% set events = [] %}
{% for courseItem in coursesapifull.courses %}
  {% if course.id == null or courseItem.id == course.id %}
    {% for courseInstance in courseItem.schedule %}
      {% if events.push(courseInstance | formatScheduleInstance("metadata", courseItem)) %}{% endif %}
    {% endfor %}
  {% endif %}
{% endfor %}
<script type="application/ld+json">
[{{ events | join(",") | safe }}]
</script>
