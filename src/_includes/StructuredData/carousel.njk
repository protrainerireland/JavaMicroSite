<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement":[
        {% for course in coursesapifull.courses %}
            {
                "@type":"ListItem", 
                "position": {{ loop.index }}, 
                "item": {
                    "@type": "Course", 
                    "url": "https://{{ site.url }}/courses/{{ course.name | slug | removeInvalidChars }}/", 
                    "name": {{ course.name | dump | safe }}, 
                    "description": {{ course.descrip | dump | safe }}, 
                    "provider":{
                        "@type": "EducationalOrganization", 
                        "name": "Professional Training", 
                        "sameAs": "https://www.professional.ie", 
                        "department":{
                            "@type": "EducationalOrganization", 
                            "name": "{{ site.organisation.department }}",
                            "url": "https://{{ site.url }}/"
                        }
                    }
                }
            }{%if loop.index < coursesapifull.courses.length %},{% endif %}

        {% endfor %}

    ]
}
</script>

  